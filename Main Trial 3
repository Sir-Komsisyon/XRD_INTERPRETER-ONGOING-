def analyze_xrd_pdf(pdf_path:       str,
                    page_index:     int   = 1,
                    two_theta_min:  float = TWO_THETA_MIN,
                    two_theta_max:  float = TWO_THETA_MAX,
                    wavelength:     float = WAVELENGTH_ANGSTROM,
                    show_plot:      bool  = True,
                    save_csv:       bool  = True,
                    csv_path:       str   = "xrd_peaks.csv") -> pd.DataFrame:
    """
    Full pipeline — call this function to analyze an XRD PDF.

    Parameters
    ----------
    pdf_path      : path to your XRD lab report PDF
    page_index    : page number containing the XRD graph (0-indexed)
    two_theta_min : minimum 2θ from machine settings
    two_theta_max : maximum 2θ from machine settings
    wavelength    : X-ray wavelength in Å (default Cu-Kα = 1.54056)
    show_plot     : whether to display the matplotlib figure
    save_csv      : whether to export the table to CSV
    csv_path      : output CSV filename

    Returns
    -------
    pd.DataFrame  : the Bragg peak table
    """

    print(f"\n{'─'*55}")
    print(f"  XRD Analyzer  |  {pdf_path}")
    print(f"  2θ range : {two_theta_min}° – {two_theta_max}°")
    print(f"  λ        : {wavelength} Å  (n={BRAGG_ORDER})")
    print(f"{'─'*55}\n")

    # ── Step 1: Load PDF page as image ────────────────────────────────────────
    print("[1] Loading PDF...")
    raw_arr = load_pdf_as_image(pdf_path, page_index=page_index)

    # ── Step 2: Crop to plot area only ────────────────────────────────────────
    print("[2] Cropping plot area...")
    cropped = crop_plot_area(raw_arr)

    # ── Step 3: Extract curve pixels → (2θ, intensity) ───────────────────────
    print("[3] Extracting diffraction curve...")
    two_theta, intensity = extract_curve(cropped, two_theta_min, two_theta_max)

    # ── Step 4: Smooth + baseline correction ──────────────────────────────────
    print("[4] Smoothing signal + baseline correction...")
    intensity = smooth_signal(intensity, window=21)
    intensity = baseline_correction(intensity)

    # Renormalize after correction
    if intensity.max() > 0:
        intensity = intensity / intensity.max()

    # ── Step 5: Detect peaks ──────────────────────────────────────────────────
    print("[5] Detecting peaks...")
    peak_tt, peak_int, _ = detect_peaks(two_theta, intensity)
    print(f"    → {len(peak_tt)} peaks detected.")

    # ── Step 6: Isolate dense cluster if peaks are scattered ──────────────────
    cluster_range = None
    if len(peak_tt) > 3:
        span = peak_tt[-1] - peak_tt[0] if len(peak_tt) > 1 else 0
        density = len(peak_tt) / (span + 1e-3)

        if density < 0.5:           # sparse: fewer than 1 peak per 2°
            print("[6] Peaks are scattered — isolating dense cluster...")
            _, _, c_start, c_end = isolate_peak_cluster(
                peak_tt, peak_int, two_theta, intensity)
            cluster_range = (c_start, c_end)
            print(f"    → Dense region: {c_start:.1f}° – {c_end:.1f}°")

            # Re-detect peaks within the cluster only
            mask     = (two_theta >= c_start) & (two_theta <= c_end)
            peak_tt, peak_int, _ = detect_peaks(
                two_theta[mask], intensity[mask])
        else:
            print("[6] Peak distribution OK — no cluster isolation needed.")
    else:
        print("[6] Too few peaks for cluster analysis.")

    # ── Step 7: Build Bragg table ─────────────────────────────────────────────
    print("[7] Building Bragg's Law table...")
    print(f"    Formula: d = nλ / (2·sin(θ))  where λ={wavelength} Å, n={BRAGG_ORDER}")
    df = build_peak_table(peak_tt, peak_int, wavelength=wavelength)

    # ── Output ────────────────────────────────────────────────────────────────
    print_peak_table(df)

    if save_csv:
        save_table_csv(df, csv_path)

    if show_plot:
        plot_results(
            two_theta, intensity,
            peak_tt, peak_int,
            df,
            cluster_range=cluster_range,
            title=f"XRD Analysis  |  λ={wavelength} Å  |  "
                  f"2θ: {two_theta_min}°–{two_theta_max}°"
        )

    return df


