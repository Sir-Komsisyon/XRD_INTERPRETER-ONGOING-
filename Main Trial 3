# =============================================================================
#  ╔══════════════════════════════════════════════════════════════════════╗
#  ║                      BRAGG'S LAW FUNCTIONS                          ║
#  ║                                                                      ║
#  ║   nλ = 2d · sin(θ)                                                  ║
#  ║   d  = nλ / (2 · sin(θ))                                            ║
#  ║   θ  = arcsin(nλ / 2d)                                              ║
#  ╚══════════════════════════════════════════════════════════════════════╝
# =============================================================================

def bragg_d_spacing(two_theta_deg: float,
                    wavelength: float = WAVELENGTH_ANGSTROM,
                    n: int = BRAGG_ORDER) -> float:
    """
    ┌─────────────────────────────────────────────────────┐
    │  BRAGG'S LAW  →  calculate d-spacing from 2θ        │
    │                                                     │
    │  Formula:  d = nλ / (2 · sin(θ))                   │
    │                                                     │
    │  Inputs:                                            │
    │    two_theta_deg : measured 2θ angle in degrees     │
    │    wavelength    : X-ray wavelength in Å            │
    │    n             : reflection order (default = 1)   │
    │                                                     │
    │  Output:                                            │
    │    d-spacing in Angstroms (Å)                       │
    └─────────────────────────────────────────────────────┘
    """
    theta_deg = two_theta_deg / 2.0          # θ = 2θ / 2
    theta_rad = np.radians(theta_deg)        # convert to radians for sin()

    if np.sin(theta_rad) < 1e-9:
        return np.nan                        # avoid division by zero at 2θ=0

    d = (n * wavelength) / (2.0 * np.sin(theta_rad))
    return round(d, 5)


def bragg_theta(two_theta_deg: float) -> float:
    """
    ┌─────────────────────────────────────────────────────┐
    │  BRAGG'S LAW  →  get θ (theta) from 2θ             │
    │                                                     │
    │  Formula:  θ = 2θ / 2                               │
    │                                                     │
    │  This is the Bragg angle — the angle between        │
    │  the incident X-ray and the crystal plane.          │
    └─────────────────────────────────────────────────────┘
    """
    return round(two_theta_deg / 2.0, 5)


def bragg_two_theta_from_d(d_spacing: float,
                            wavelength: float = WAVELENGTH_ANGSTROM,
                            n: int = BRAGG_ORDER) -> float:
    """
    ┌─────────────────────────────────────────────────────┐
    │  BRAGG'S LAW  →  calculate 2θ from known d-spacing  │
    │                                                     │
    │  Formula:  2θ = 2 · arcsin(nλ / 2d)               │
    │                                                     │
    │  Used for: generating theoretical peak positions    │
    │  from reference database d-spacing values           │
    └─────────────────────────────────────────────────────┘
    """
    ratio = (n * wavelength) / (2.0 * d_spacing)
    if abs(ratio) > 1.0:
        return np.nan                        # physically impossible
    two_theta_rad = 2.0 * np.arcsin(ratio)
    return round(np.degrees(two_theta_rad), 5)


