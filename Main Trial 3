def save_table_csv(df: pd.DataFrame, out_path: str = "xrd_peaks.csv"):
    """Export the Bragg table to a CSV file."""
    if df.empty:
        print("Nothing to save — table is empty.")
        return
    df.to_csv(out_path)
    print(f"Peak table saved to: {out_path}")


